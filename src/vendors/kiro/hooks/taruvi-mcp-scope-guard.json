{
  "version": "v1",
  "hooks": [
    {
      "name": "Taruvi MCP Scope Guard",
      "description": "Before any Taruvi MCP tool call, confirm which Taruvi server the call will hit and that the live session has actually bound the current config. Kiro merges MCP config user < workspace and binds servers at session start, so a freshly cloned template can silently operate against another project's tenant.",
      "trigger": "PreToolUse",
      "matcher": "([Tt][Aa][Rr][Uu][Vv][Ii]|[Mm][Cc][Pp].*(get_datatable_schema|create_update_schema|datatable_data|datatable_edges|delete_datatable|execute_raw_sql|manage_policies|manage_function|execute_function|manage_query|execute_query|manage_roles|manage_role_assignments|list_users|create_user|update_user|user_attributes_schema|manage_storage|list_secrets|get_secret|create_update_secret|manage_secret_types|manage_tags|get_ai_docs))|[Mm][Cc][Pp].*(get_sites|get_apps|get_tables|save_tables|delete_tables|get_records|save_records|delete_records|get_edges|create_edges|delete_edges|get_functions|save_functions|delete_functions|run_functions|get_function_results|get_buckets|create_buckets|get_objects|get_users|create_users|update_users|get_user_attribute_schema|save_user_attribute_schema|get_roles|create_roles|delete_roles|assign_roles|revoke_roles|get_policies|save_policies|disable_policies|get_secrets|save_secrets|get_secret_types|create_secret_types|update_secret_types|delete_secret_types|get_queries|create_queries|update_queries|delete_queries|run_queries|get_event_subscribers|subscribe_functions|unsubscribe_functions|report_bug|get_organizations|create_sites|update_sites|create_apps|update_apps)",
      "action": {
        "type": "command",
        "command": "python3 .kiro/scripts/mcp_scope.py --quiet"
      },
      "timeout": 20
    }
  ]
}
