{
  "name": "@taruvi/agents-plugin",
  "version": "0.1.0",
  "description": "Installer for Taruvi agent support across Claude, Codex, Cursor, and Kiro.",
  "type": "module",
  "bin": {
    "taruvi-agents-plugin": "./bin/taruvi-agents-plugin.js"
  },
  "scripts": {
    "build:vendor-files": "bash scripts/build-vendor-files.sh",
    "validate:agent-plugin": "node scripts/validate-agent-plugin.mjs",
    "validate:vendors": "node scripts/validate-vendor-files.mjs",
    "prepack": "npm run build:vendor-files && npm run validate:agent-plugin && npm run validate:vendors",
    "test": "npm run build:vendor-files && npm run validate:agent-plugin && npm run validate:vendors && node --test tests/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check:generated": "node scripts/check-generated.mjs"
  },
  "files": [
    "bin/",
    "mcp.json",
    "llms.txt",
    "payload/",
    "plugin.json",
    "scripts/",
    "skills/",
    "src/",
    "README.md",
    "schemas/",
    "docs/"
  ],
  "keywords": [
    "taruvi",
    "agents",
    "plugin",
    "codex",
    "claude",
    "cursor",
    "kiro"
  ],
  "author": {
    "name": "Taruvi"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
